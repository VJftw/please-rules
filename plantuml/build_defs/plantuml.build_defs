"""Build rules for rendering PlantUML (https://plantuml.com/) diagrams."""

# PLANTUML_VERSIONS: PlantUML jar checksums, keyed by version - the default
# hash for a `ToolVersion` without one of its own. Generated by
# .github/scripts/mirrors/plantuml.nu.
subinclude("//build_defs:versions")

# PlantUML's `-t<format>` flag, mapped to the default output file extension.
_FORMATS = {
    "svg": "svg",
    "png": "png",
    "eps": "eps",
    "pdf": "pdf",
    "txt": "txt",
    "utxt": "utxt",
}

# Flags for the JVM that runs PlantUML.
_JVM_ARGS = [
    "-Djava.awt.headless=true",
    # The diagram is written to stdout, so nothing else can be: the JVM's own
    # warnings go there by default (e.g. about its shared /tmp/hsperfdata_*
    # performance data file, when several JVMs run at once - which that
    # also turns off, as nothing here reads it).
    "-XX:-UsePerfData",
    "-Xlog:disable",
    "-Xlog:all=warning:stderr",
    # PNG rendering reflectively accesses a JDK-internal ImageIO class, which JDK 17+ blocks by
    # default. See https://github.com/plantuml/plantuml/issues/1830.
    "--add-opens=java.desktop/com.sun.imageio.plugins.png=ALL-UNNAMED",
]


def plantuml_jar_hashes(version:str) -> list:
    """The hashes to verify PlantUML `version`'s jar from Maven Central with -
    from the plugin's checksum mirror (build_defs/versions.build_defs) - or
    none if it isn't there.
    """
    known = PLANTUML_VERSIONS.get(version)
    return [f"sha256: {known}"] if known else []


def plantuml_library(name:str, srcs:list=[], deps:list=[], visibility:list=None, labels:list=[]):
    """A reusable set of PlantUML include files (e.g. shared styling or macros), which
    `plantuml_diagram`s and other `plantuml_library`s can `!include` by listing it in their `deps`.

    Its own `deps` are exported, so a diagram that depends on a library only needs to list that
    library and not everything it transitively `!include`s.

    Args:
      name: Name of the rule.
      srcs: This library's own PlantUML include files.
      deps: Other plantuml_library rules that `srcs` `!include`.
      visibility: Visibility declaration of the rule.
      labels: Labels to apply to this rule.
    """
    return filegroup(
        name = name,
        srcs = srcs,
        exported_deps = deps,
        visibility = visibility,
        labels = labels + ["plantuml"],
    )


def plantuml_diagram(name:str, src:str, format:str=CONFIG.PLANTUML.DEFAULT_FORMAT, out:str=None,
                     deps:list=[], visibility:list=None, labels:list=[]):
    """Renders a single PlantUML source into a diagram.

    `src` is expected to contain a single `@startuml`/`@enduml` diagram. `!include`s are resolved
    relative to the directory containing `src`, the same as when running PlantUML directly on it.

    Args:
      name: Name of the rule.
      src: The PlantUML source file to render.
      format: Output format to render. One of svg, png, eps, pdf, txt or utxt.
      out: Name of the output file. Defaults to `src`'s basename with the format's extension.
      deps: Files, filegroups or plantuml_library rules that `src` `!include`s.
      visibility: Visibility declaration of the rule.
      labels: Labels to apply to this rule.
    """
    if format not in _FORMATS:
        fail(f"Unsupported PlantUML format '{format}', must be one of: " + ", ".join(sorted(_FORMATS.keys())))

    if not out:
        base = name if looks_like_build_label(src) else splitext(basename(src))[0]
        out = base + "." + _FORMATS[format]

    jvm_args = " ".join(_JVM_ARGS)

    # Rendering via stdin/stdout means the output doesn't depend on the name PlantUML would
    # otherwise pick (from `src`, or from `@startuml <name>`), while running from `src`'s own
    # directory keeps `!include` resolution the same as rendering the file directly.
    cmd = " && ".join([
        'cd "$(dirname "$SRC")"',
        f'"$TOOLS_JAVA" {jvm_args} -jar "$TOOLS_JAR" -t{format} -charset UTF-8 -nbthread 1 -pipe < "$(basename "$SRC")" > "$OUT"',
    ])

    return build_rule(
        name = name,
        srcs = [src],
        outs = [out],
        deps = deps,
        tools = {
            "java": [CONFIG.PLANTUML.JAVA],
            "jar": [CONFIG.PLANTUML.JAR],
        },
        cmd = cmd,
        building_description = "Rendering...",
        visibility = visibility,
        labels = labels + ["plantuml"],
    )
