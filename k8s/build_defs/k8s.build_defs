"""Build rules for rendering and composing Kubernetes manifests with kustomize
(https://kustomize.io/) and Helm (https://helm.sh/), and running kubectl."""

# KUSTOMIZE_VERSIONS, HELM_VERSIONS and KUBECTL_VERSIONS: each tool's release
# checksums, keyed by version and then by `<os>_<arch>` - the default hashes
# for a version its *_tool rule isn't given `hashes` for. Generated by
# .github/scripts/mirrors/{kustomize,helm,kubectl}.nu.
subinclude("//build_defs:kustomize_versions", "//build_defs:helm_versions", "//build_defs:kubectl_versions")

_PLATFORMS = ["linux_amd64", "linux_arm64", "darwin_amd64", "darwin_arm64"]

_LOAD_RESTRICTORS = ["LoadRestrictionsNone", "LoadRestrictionsRootOnly"]


def _shell_quote(arg:str) -> str:
    return "'" + arg.replace("'", "'\\''") + "'"


def _host_platform(tool:str) -> str:
    platform = f"{CONFIG.OS}_{CONFIG.ARCH}"
    if platform not in _PLATFORMS:
        fail(f"{tool} doesn't publish a build for {platform} that this plugin knows about. Set the k8s plugin's config for it to a {tool} executable you provide instead.")
    return platform


def _default_hashes(mirror:dict, version:str, platform:str, url_template:str) -> list:
    # A mirror's checksums are for the tool's own official releases - so
    # meaningless for one fetched from somewhere else.
    known = None if url_template else mirror.get(version, {}).get(platform)
    return [f"sha256: {known}"] if known else []


def _extract_tool(name:str, download:str, member:str, out:str, visibility:list, labels:list):
    # Extracts just `member` (a path inside a .tar.gz) as a runnable binary.
    return build_rule(
        name = name,
        srcs = [download],
        outs = [out],
        cmd = " && ".join([
            'mkdir "$TMP_DIR/_extracted"',
            'tar -xzf "$SRC" -C "$TMP_DIR/_extracted" ' + _shell_quote(member),
            f'mv "$TMP_DIR/_extracted/{member}" "$OUT"',
        ]),
        binary = True,
        building_description = "Extracting...",
        visibility = visibility,
        labels = labels,
    )


def kustomize_tool(name:str, version:str, hashes:list=None, url_template:str=None, bin_name:str="kustomize",
                   visibility:list=None, labels:list=[]):
    """Downloads kustomize for the host platform from GitHub Releases.

    The result can be used as the plugin's `Kustomize`, e.g. `//third_party/k8s:kustomize`.

    Args:
      name: Name of the rule.
      version: The kustomize version to download, e.g. "5.8.1" (without the leading 'v').
      hashes: Hashes to verify the downloaded archive with. Defaults to the host
              platform's hash for `version` in the plugin's checksum mirror
              (build_defs/kustomize_versions.build_defs), if it's there and
              `url_template` isn't set.
      url_template: Downloads from here instead - with `{version}`, `{platform}`
                    (e.g. `linux_amd64`) and `{ext}` (`tar.gz`) placeholders.
      bin_name: The executable's name inside the archive.
      visibility: Visibility declaration of the rule.
      labels: Labels to apply to this rule.
    """
    platform = _host_platform("kustomize")
    template = url_template or "https://github.com/kubernetes-sigs/kustomize/releases/download/kustomize/v{version}/kustomize_v{version}_{platform}.{ext}"
    download = remote_file(
        name = name,
        _tag = "download",
        url = template.format(version = version, platform = platform, ext = "tar.gz"),
        out = f"{name}.tar.gz",
        hashes = hashes if hashes != None else _default_hashes(KUSTOMIZE_VERSIONS, version, platform, url_template),
    )
    return _extract_tool(name, download, bin_name, bin_name, visibility, labels)


def helm_tool(name:str, version:str, hashes:list=None, url_template:str=None, bin_name:str="helm",
              visibility:list=None, labels:list=[]):
    """Downloads helm for the host platform from get.helm.sh.

    The result can be used as the plugin's `Helm`, e.g. `//third_party/k8s:helm`.

    Args:
      name: Name of the rule.
      version: The helm version to download, e.g. "3.22.0" (without the leading 'v').
      hashes: Hashes to verify the downloaded archive with. Defaults to the host
              platform's hash for `version` in the plugin's (GPG-verified)
              checksum mirror (build_defs/helm_versions.build_defs), if it's
              there and `url_template` isn't set.
      url_template: Downloads from here instead - with `{version}`,
                    `{platform_dash}` (e.g. `linux-amd64`) and `{ext}` (`tar.gz`)
                    placeholders.
      bin_name: The executable's name inside the archive's `<os>-<arch>/` directory.
      visibility: Visibility declaration of the rule.
      labels: Labels to apply to this rule.
    """
    platform = _host_platform("helm")
    platform_dash = platform.replace("_", "-")
    template = url_template or "https://get.helm.sh/helm-v{version}-{platform_dash}.{ext}"
    download = remote_file(
        name = name,
        _tag = "download",
        url = template.format(version = version, platform_dash = platform_dash, ext = "tar.gz"),
        out = f"{name}.tar.gz",
        hashes = hashes if hashes != None else _default_hashes(HELM_VERSIONS, version, platform, url_template),
    )
    return _extract_tool(name, download, f"{platform_dash}/{bin_name}", bin_name, visibility, labels)


def kubectl_tool(name:str, version:str, hashes:list=None, url_template:str=None, bin_name:str="kubectl",
                 visibility:list=None, labels:list=[]):
    """Downloads kubectl for the host platform from dl.k8s.io.

    The result can be used as the plugin's `Kubectl`, e.g.
    `//third_party/k8s:kubectl` - and run directly: `plz run
    //third_party/k8s:kubectl -- version --client`.

    Args:
      name: Name of the rule.
      version: The kubectl version to download, e.g. "1.37.1" (without the
               leading 'v') - see https://dl.k8s.io/release/stable.txt for
               the latest.
      hashes: Hashes to verify the downloaded binary with. Defaults to the host
              platform's hash for `version` in the plugin's (cosign-verified)
              checksum mirror (build_defs/kubectl_versions.build_defs), if
              it's there and `url_template` isn't set.
      url_template: Downloads from here instead - with `{version}`, `{os}`,
                    `{arch}` and `{ext}` (empty) placeholders.
      bin_name: The downloaded executable's name.
      visibility: Visibility declaration of the rule.
      labels: Labels to apply to this rule.
    """
    platform = _host_platform("kubectl")
    template = url_template or "https://dl.k8s.io/release/v{version}/bin/{os}/{arch}/kubectl{ext}"
    return remote_file(
        name = name,
        url = template.format(version = version, os = CONFIG.OS, arch = CONFIG.ARCH, ext = ""),
        out = bin_name,
        hashes = hashes if hashes != None else _default_hashes(KUBECTL_VERSIONS, version, platform, url_template),
        binary = True,
        visibility = visibility,
        labels = labels,
    )


def kustomize_build(name:str, kustomization:str, srcs:list=[], resources:dict={}, out:str=None,
                    load_restrictor:str="LoadRestrictionsNone", visibility:list=None, labels:list=[]):
    """Renders a kustomization directory into a single merged Kubernetes manifest,
    via `kustomize build <dir-of-kustomization> --output <out>`.

    `kustomization` must be named exactly `kustomization.yaml`,
    `kustomization.yml` or `Kustomization` (kustomize's own requirement).
    `srcs` must list every other file it (and any bases it references,
    however deeply) needs - resources, patches, generators, and any base
    directories' own kustomization files - e.g. via a `filegroup` in each
    base's package, so a `resources: [../base]` reference resolves.

    `resources` makes other rules' outputs - typically a `helm_template`, or
    another `kustomize_build` - available at a literal path within
    `kustomization`'s own directory, keyed by that path: e.g.
    `{"rendered.yaml": "//chart:hello"}` for a kustomization that declares
    `resources: [rendered.yaml]`. That's what makes this kustomization's own
    transformers (`namespace`, labels, patches, ...) apply to it - they only
    apply to resources declared within the same kustomization. Each must be a
    rule with exactly one output.

    Args:
      name: Name of the rule.
      kustomization: This rule's own kustomization file.
      srcs: Every other file `kustomization` references, directly or (via
            bases) transitively.
      resources: Other rules' outputs to make available within
                 `kustomization`'s directory, keyed by their path there.
      out: Output filename. Defaults to the rule's name + '.yaml'.
      load_restrictor: Passed through to kustomize's `--load-restrictor`.
                       Defaults to LoadRestrictionsNone rather than kustomize's
                       own RootOnly default - Please can make a build's
                       sources symlinks, which RootOnly refuses to follow.
                       Please's own build sandboxing (only `srcs` are there)
                       already provides the isolation it's for.
      visibility: Visibility declaration of the rule.
      labels: Labels to apply to this rule.
    """
    if load_restrictor not in _LOAD_RESTRICTORS:
        fail(f"kustomize_build's load_restrictor must be one of {_LOAD_RESTRICTORS}, not {load_restrictor}")
    if looks_like_build_label(kustomization):
        fail("kustomize_build's kustomization must be a file in this package")
    kustomization_dir = join_path(package_name(), dirname(kustomization))

    # Copy each resource into place next to the kustomization - in the build's
    # own (writable) temporary directory, not the real source tree.
    cmd = []
    for path in sorted(resources.keys()):
        label = resources[path]
        dest = join_path(kustomization_dir, path)
        quoted_dest = _shell_quote(dest)
        cmd += [f'mkdir -p "$(dirname {quoted_dest})"', f'cp "$(location {label})" {quoted_dest}']
    cmd += [" ".join([
        '"$TOOL" build',
        _shell_quote(kustomization_dir),
        '--output "$OUT"',
        "--load-restrictor",
        load_restrictor,
    ])]

    return build_rule(
        name = name,
        srcs = {"kustomization": [kustomization], "srcs": srcs, "resources": sorted(resources.values())},
        outs = [out or f"{name}.yaml"],
        tools = [CONFIG.K8S.KUSTOMIZE],
        cmd = " && ".join(cmd),
        building_description = "Rendering kustomization...",
        visibility = visibility,
        labels = labels + ["k8s"],
    )


def helm_template(name:str, chart_yaml:str, srcs:list=[], values:list=[], set_values:list=[], release_name:str=None,
                  namespace:str=None, include_crds:bool=True, out:str=None, visibility:list=None, labels:list=[]):
    """Renders a Helm chart into a single merged Kubernetes manifest, via `helm
    template <release_name> <dir-of-chart_yaml> ...`.

    Args:
      name: Name of the rule.
      chart_yaml: The chart's own Chart.yaml.
      srcs: Every other file the chart needs - values.yaml, templates/**, any
            vendored charts/** subcharts, etc.
      values: Extra values files, passed via repeated `-f`, in order.
      set_values: Extra `--set KEY=VALUE` overrides, in order.
      release_name: The release name. Defaults to the rule's name.
      namespace: If set, passed via `--namespace`.
      include_crds: Whether to pass `--include-crds`.
      out: Output filename. Defaults to the rule's name + '.yaml'.
      visibility: Visibility declaration of the rule.
      labels: Labels to apply to this rule.
    """
    if looks_like_build_label(chart_yaml):
        fail("helm_template's chart_yaml must be a file in this package")
    chart_dir = join_path(package_name(), dirname(chart_yaml))

    args = ['"$TOOL" template', _shell_quote(release_name or name), _shell_quote(chart_dir)]
    if namespace:
        args += ["--namespace", _shell_quote(namespace)]
    if include_crds:
        args += ["--include-crds"]
    args += ['$(for f in $SRCS_VALUES; do echo -f "$f"; done)']
    for value in set_values:
        args += ["--set", _shell_quote(value)]

    return build_rule(
        name = name,
        srcs = {"chart_yaml": [chart_yaml], "srcs": srcs, "values": values},
        outs = [out or f"{name}.yaml"],
        tools = [CONFIG.K8S.HELM],
        cmd = " && ".join([
            # Helm's own config/cache/data directories, out of the way of
            # (and not depending on) the user's.
            'export HELM_CACHE_HOME="$TMP_DIR/.helm/cache" HELM_CONFIG_HOME="$TMP_DIR/.helm/config" HELM_DATA_HOME="$TMP_DIR/.helm/data"',
            " ".join(args) + ' > "$OUT"',
        ]),
        building_description = "Rendering chart...",
        visibility = visibility,
        labels = labels + ["k8s"],
    )


def k8s_manifests(name:str, srcs:list=[], deps:list=[], visibility:list=None, labels:list=[]):
    """Aggregates plain manifest files (`srcs`) and/or other rules' manifests
    (`deps` - helm_template, kustomize_build, or another k8s_manifests) into a
    single directory, `<name>/`, keeping each at its path relative to the
    repository root (so files with the same name from different packages
    don't collide) - e.g. for `kubectl apply -R -f plz-out/gen/<path>/<name>/`.

    Another k8s_manifests in `deps` has its own directory's contents merged
    in, so an "everything for this environment" bundle built from smaller
    ones only needs listing once by whatever uses it.

    Args:
      name: Name of the rule (and its output directory).
      srcs: This rule's own plain manifest files.
      deps: Other rules whose manifests are aggregated in too.
      visibility: Visibility declaration of the rule.
      labels: Labels to apply to this rule.
    """
    return build_rule(
        name = name,
        srcs = srcs + deps,
        outs = [name],
        cmd = " && ".join([
            'mkdir -p "$OUT"',
            'for f in $SRCS; do if [ -d "$f" ]; then cp -RL "$f/." "$OUT/"; else mkdir -p "$OUT/$(dirname "$f")" && cp -L "$f" "$OUT/$f"; fi; done',
        ]),
        building_description = "Aggregating manifests...",
        visibility = visibility,
        labels = labels + ["k8s"],
    )


def kubectl_binary(name:str, visibility:list=None, labels:list=[]):
    """A runnable kubectl - the plugin's `Kubectl` - via `plz run //path:name --
    <args>`, against whatever kubeconfig/cluster the invoking shell's own
    environment points at.

    The plugin's default kubectl (`///k8s//third_party/k8s:kubectl`) can be
    run directly too; this is for a target of your own, e.g. with a different
    visibility.

    Args:
      name: Name of the rule.
      visibility: Visibility declaration of the rule.
      labels: Labels to apply to this rule.
    """
    tool = CONFIG.K8S.KUBECTL
    if looks_like_build_label(tool):
        tool_path = f"$(out_exe {tool})"
        tools = [tool]
    else:
        tool_path = tool
        tools = []
    launcher = "\n".join([
        "#!/bin/sh",
        "# Generated by the k8s Please plugin: runs kubectl.",
        'case "$0" in /*) self="$0" ;; *) self="$PWD/$0" ;; esac',
        "kubectl=__KUBECTL__",
        # Relative to the repository root - which Please always runs this
        # from under, in plz-out.
        'case "$kubectl" in */*) kubectl="${self%%/plz-out/*}/$kubectl" ;; esac',
        'exec "$kubectl" "$@"',
        "",
    ])
    return build_rule(
        name = name,
        outs = [name],
        tools = tools,
        # Please can give a built tool's path as an absolute one - store it
        # relative to the repository root instead, so the launcher doesn't
        # depend on where the repository is.
        cmd = "\n".join([
            f"cat > \"$TMP_DIR/launcher.sh\" << 'EOF'\n{launcher}EOF",
            f'kubectl="{tool_path}"',
            'case "$kubectl" in /*/plz-out/*) kubectl="plz-out/${kubectl#*/plz-out/}" ;; esac',
            'sed -e "s#__KUBECTL__#$kubectl#" "$TMP_DIR/launcher.sh" > "$OUT"',
        ]),
        binary = True,
        building_description = "Generating launcher...",
        visibility = visibility,
        labels = labels + ["k8s"],
    )
