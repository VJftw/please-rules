"""Build rules for hermetic, per-target Terraform (https://www.terraform.io/):
modules validated as part of the build, runnable roots (`plz run //path:root --
plan`), an offline provider mirror and pre-fetched registry modules."""

# TERRAFORM_VERSIONS: Terraform 1.x release checksums, keyed by version and
# then by `<os>_<arch>` - the default hashes for a version terraform_toolchain
# isn't given `hashes` for. Generated by .github/scripts/mirrors/terraform.nu.
subinclude("//build_defs:versions")

# The plugin's own build actions and runner - see scripts/.
_BUILD_MODULE = "///terraform//scripts:build_module"
_BUILD_REGISTRY_MODULE = "///terraform//scripts:build_registry_module"
_RUNNER = "///terraform//scripts:runner"

# Set by the runner itself, so they can't be set via `env`/`env_labels`.
_RESERVED_ENV_NAMES = ["TF_BIN", "TF_MODULE_DIR", "TF_CLI_CONFIG_FILE", "TF_LABEL", "TF_ROOT_NAME", "TF_ROOT_PACKAGE", "TF_VERSION"]

_PROVIDER_HOSTNAME = "registry.terraform.io"


def _shell_quote(arg:str) -> str:
    return "'" + arg.replace("'", "'\\''") + "'"


def _host_platform() -> str:
    return f"{CONFIG.OS}_{CONFIG.ARCH}"


def _heredoc(path:str, content:str) -> str:
    # Writes `content` to `path`, after Please has expanded any $(location ...)
    # in it - a quoted heredoc stops the shell expanding anything else.
    return f"cat > {path} << 'PLZ_TERRAFORM_EOF'\n{content}\nPLZ_TERRAFORM_EOF"


def _host_hashes(hashes, mirror_default:str) -> list:
    # `hashes` is a list (used as-is), a dict of platform -> sha256 (the host
    # platform's is used), or None (the mirror's default, if any).
    if hashes == None:
        return [f"sha256: {mirror_default}"] if mirror_default else []
    if isinstance(hashes, dict):
        sha256 = hashes.get(_host_platform())
        return [f"sha256: {sha256}"] if sha256 else []
    return hashes


def _extract_cmd(member:str="") -> str:
    # Extracts the downloaded archive (zip or tar) into $TMP_DIR/_extracted
    # with Please's own arcat tool.
    return '"$TOOLS_ARCAT" x "$SRCS" -o "$TMP_DIR/_extracted"'


def terraform_toolchain(name:str, version:str, hashes:list|dict=None, url_template:str=None, bin_name:str="terraform",
                        visibility:list=None, labels:list=[]):
    """Downloads a Terraform (or Terraform-compatible fork, e.g. OpenTofu) CLI for
    the host platform, for a terraform_module/terraform_root's `toolchain`.

    The plugin already has one of these for every Terraform release in its
    checksum mirror - which is what `version = "..."` refers to - so this is
    only needed for one that isn't, e.g. a fork:

        terraform_toolchain(
            name = "tofu_1.7.0",
            version = "1.7.0",
            url_template = "https://github.com/opentofu/opentofu/releases/download/v{version}/tofu_{version}_{platform}.zip",
            bin_name = "tofu",
            hashes = {"linux_amd64": "...", "darwin_arm64": "..."},
        )

    Args:
      name: Name of the rule.
      version: The version to download, e.g. "1.6.0".
      hashes: Hashes to verify the downloaded archive with - a list, or a dict
              of platform (e.g. "linux_amd64") to sha256. Defaults to the host
              platform's hash for `version` in the plugin's (GPG-verified)
              checksum mirror (build_defs/versions.build_defs), if it's there
              and `url_template` isn't set.
      url_template: Downloads from here instead of releases.hashicorp.com -
                    with `{version}` and `{platform}` (e.g. `linux_amd64`)
                    placeholders.
      bin_name: The executable's name inside the archive, e.g. "tofu".
      visibility: Visibility declaration of the rule.
      labels: Labels to apply to this rule.
    """
    platform = _host_platform()
    template = url_template or "https://releases.hashicorp.com/terraform/{version}/terraform_{version}_{platform}.zip"
    # The mirror's checksums are for HashiCorp's own archives - so meaningless
    # for one fetched from somewhere else.
    mirror_default = None if url_template else TERRAFORM_VERSIONS.get(version, {}).get(platform)
    download = remote_file(
        name = name,
        _tag = "download",
        url = template.format(version = version, platform = platform),
        out = f"{name}.zip",
        hashes = _host_hashes(hashes, mirror_default),
    )
    return build_rule(
        name = name,
        srcs = [download],
        # In its own directory, so several in one package don't collide - and
        # the binary keeps its own name (e.g. for the runner's PATH entry).
        outs = [f"{name}/{bin_name}"],
        tools = {"arcat": [CONFIG.ARCAT_TOOL]},
        cmd = _extract_cmd() + f' && mv "$TMP_DIR/_extracted/{bin_name}" "$OUT"',
        binary = True,
        building_description = "Extracting...",
        visibility = visibility,
        labels = labels + [f"terraform_version:{version}"],
    )


def terraform_provider(name:str, source:str, version:str, hashes:list|dict=None, url_template:str=None,
                       hostname:str=_PROVIDER_HOSTNAME, visibility:list=None, labels:list=[]):
    """Downloads a Terraform provider plugin for the host platform, into a
    Terraform filesystem-mirror layout - for a terraform_module/
    terraform_root's `providers` (or the plugin's `DefaultProviders`) - so
    `terraform init` installs it from there, never over the network.

    Only HashiCorp-published providers (`hashicorp/<name>`, from
    releases.hashicorp.com) can be fetched without `url_template` - a
    third-party provider needs its own release URL, e.g. Cloudflare's:

        terraform_provider(
            name = "cloudflare",
            source = "cloudflare/cloudflare",
            version = "5.24.0",
            url_template = "https://github.com/cloudflare/terraform-provider-cloudflare/releases/download/v{version}/terraform-provider-cloudflare_{version}_{platform}.zip",
            hashes = {"linux_amd64": "...", "darwin_arm64": "..."},
        )

    Args:
      name: Name of the rule.
      source: The provider's source address, e.g. "hashicorp/random" or "cloudflare/cloudflare".
      version: The provider version, e.g. "3.6.0".
      hashes: Hashes to verify the downloaded archive with - a list, or a dict
              of platform (e.g. "linux_amd64") to sha256. There's no checksum
              mirror for providers.
      url_template: Downloads from here instead - with `{namespace}`, `{name}`,
                    `{version}` and `{platform}` placeholders. Required for
                    anything but a `hashicorp/` provider.
      hostname: The registry hostname its source address implies.
      visibility: Visibility declaration of the rule.
      labels: Labels to apply to this rule.
    """
    parts = source.split("/")
    if len(parts) != 2:
        fail(f'terraform_provider\'s source must be "<namespace>/<name>", not "{source}"')
    namespace = parts[0]
    provider = parts[1]
    if namespace != "hashicorp" and not url_template:
        fail(f"terraform_provider can only fetch HashiCorp-published providers (hashicorp/<name>) without a url_template - set one to fetch {source} from its own release URL")
    platform = _host_platform()
    template = url_template or "https://releases.hashicorp.com/terraform-provider-{name}/{version}/terraform-provider-{name}_{version}_{platform}.zip"
    download = remote_file(
        name = name,
        _tag = "download",
        url = template.format(namespace = namespace, name = provider, version = version, platform = platform),
        out = f"{name}.zip",
        hashes = _host_hashes(hashes, None),
    )
    mirror_dir = join_path(hostname, namespace, provider, version, platform)
    return build_rule(
        name = name,
        srcs = [download],
        outs = [name],
        tools = {"arcat": [CONFIG.ARCAT_TOOL]},
        cmd = " && ".join([
            _extract_cmd(),
            'mkdir -p "$OUT/' + join_path(hostname, namespace, provider, version) + '"',
            f'mv "$TMP_DIR/_extracted" "$OUT/{mirror_dir}"',
        ]),
        building_description = "Extracting...",
        visibility = visibility,
        labels = labels + ["terraform_provider"],
    )


def terraform_local_provider(name:str, binary:str, source:str, version:str, hostname:str=_PROVIDER_HOSTNAME,
                             visibility:list=None, labels:list=[]):
    """An in-repo-built Terraform provider plugin (e.g. a go_binary implementing
    the plugin protocol), laid out as a Terraform filesystem mirror the same
    way terraform_provider does - so `terraform init` installs it from there,
    with no published release, registry or network fetch.

    Its source address in `required_providers` is `<hostname>/<source>`, e.g.
    `local/myorg/myprovider` for `hostname = "local"` - a hostname of your own
    avoids colliding with a real registry.terraform.io namespace.

    Args:
      name: Name of the rule.
      binary: The provider plugin's executable.
      source: The provider's source address, without its hostname - e.g. "myorg/myprovider".
      version: The provider's version, e.g. "0.1.0".
      hostname: The hostname in its source address.
      visibility: Visibility declaration of the rule.
      labels: Labels to apply to this rule.
    """
    parts = source.split("/")
    if len(parts) != 2:
        fail(f'terraform_local_provider\'s source must be "<namespace>/<name>", not "{source}"')
    provider = parts[1]
    placed = join_path(hostname, parts[0], provider, version, _host_platform(), f"terraform-provider-{provider}_v{version}")
    return build_rule(
        name = name,
        srcs = [binary],
        outs = [name],
        cmd = f'mkdir -p "$(dirname "$OUT/{placed}")" && cp -L "$SRCS" "$OUT/{placed}" && chmod +x "$OUT/{placed}"',
        building_description = "Laying out provider...",
        visibility = visibility,
        labels = labels + ["terraform_provider"],
    )


def terraform_registry_module(name:str, source:str, url:str, version:str="", hashes:list=None, strip_prefix:str="",
                              nested:dict={}, visibility:list=None, labels:list=[]):
    """A third-party (registry or git) Terraform module, fetched hermetically -
    for a terraform_module/terraform_root's `registry_modules`, so `terraform
    init` never resolves it over the network.

    `url` is a concrete, directly downloadable archive of the module's content
    - not resolved via the Terraform Registry API. For a registry module, its
    download address is `curl -sD -
    https://registry.terraform.io/v1/modules/<namespace>/<name>/<provider>/<version>/download`'s
    `x-terraform-get` header; for a GitHub-backed one (`git::https://github.com/<owner>/<repo>?ref=<ref>`),
    the archive is `https://github.com/<owner>/<repo>/archive/<ref>.tar.gz`,
    with `strip_prefix = "<repo>-<ref>"`.

    Args:
      name: Name of the rule.
      source: The module's source address exactly as Terraform's manifest
              records it - e.g. "registry.terraform.io/cloudposse/label/null"
              (with the "registry.terraform.io/" prefix, even though a .tf
              file's own `source` can omit it), or a "git::..." address.
      url: A directly downloadable archive (zip or tar) of the module.
      version: The resolved module version, for a registry source.
      hashes: Hashes to verify the archive with.
      strip_prefix: A directory prefix to strip from the archive.
      nested: Other terraform_registry_module rules this module's own .tf
              files call internally, keyed by the module call's name inside
              this module's source - the plugin never parses .tf files, so
              can't discover these itself.
      visibility: Visibility declaration of the rule.
      labels: Labels to apply to this rule.
    """
    download = remote_file(
        name = name,
        _tag = "download",
        url = url,
        out = name + "_" + basename(url),
        hashes = hashes,
    )
    spec = json({
        "source": source,
        "version": version,
        "nested": {call: f"$(location {label})" for call, label in nested.items()},
    })
    strip = " -s " + _shell_quote(strip_prefix) if strip_prefix else ""
    return build_rule(
        name = name,
        srcs = {"archive": [download], "nested": sorted(nested.values())},
        outs = [name],
        tools = {"arcat": [CONFIG.ARCAT_TOOL], "nu": [CONFIG.TERRAFORM.NUSHELL], "script": [_BUILD_REGISTRY_MODULE]},
        cmd = "\n".join([
            _heredoc('"$TMP_DIR/spec.json"', spec),
            f'"$TOOLS_ARCAT" x "$SRCS_ARCHIVE" -o "$TMP_DIR/_files"{strip}',
            '"$TOOLS_NU" --no-config-file "$TOOLS_SCRIPT" "$TMP_DIR/spec.json" "$OUT" "$TMP_DIR/_files"',
        ]),
        building_description = "Fetching module...",
        visibility = visibility,
        labels = labels + ["terraform_registry_module"],
    )


def _toolchain(version:str, toolchain:str) -> str:
    if (version == None) == (toolchain == None):
        fail("set exactly one of `version` (a Terraform release in the plugin's checksum mirror) and `toolchain` (a terraform_toolchain rule)")
    if toolchain:
        return toolchain
    if version not in TERRAFORM_VERSIONS:
        fail(f"Terraform {version} isn't in the plugin's checksum mirror - declare a terraform_toolchain for it (with its own `hashes`) and pass it as `toolchain` instead")
    return f"///terraform//third_party/terraform:terraform_{version}"


def _module_rule(name:str, out:str, srcs:list, deps:dict, dep_sources:dict, registry_modules:dict, providers:list,
                 toolchain:str, validate:bool, visibility:list, labels:list):
    """The rule both terraform_module and terraform_root build their module with.

    Its output, `out/`, holds `tree/` - this module's own files, plus every
    dep's (at their paths relative to the repository root, so local `source =
    "../foo"` references resolve), plus each of its registry modules (under
    `<its directory>/_registry_modules/<key>/`) - and `module.json`,
    describing the `.terraform/modules/modules.json` entries Terraform needs
    for them. See scripts/build_module.nu.
    """
    providers = providers + CONFIG.TERRAFORM.DEFAULT_PROVIDERS
    src_paths = []
    for src in srcs:
        src_paths += [f"$(locations {src})" if looks_like_build_label(src) else join_path(package_name(), src)]
    spec = json({
        "label": canonicalise(f":{name}"),
        "own_relpath": package_name(),
        "srcs": src_paths,
        "deps": {key: f"$(location {label})" for key, label in deps.items()},
        "dep_sources": dep_sources,
        "registry_modules": {key: f"$(location {label})" for key, label in registry_modules.items()},
        "providers": [f"$(location {provider})" for provider in providers],
        "validate": validate,
    })
    return build_rule(
        name = name,
        srcs = {
            "srcs": srcs,
            "deps": sorted(deps.values()),
            "registry_modules": sorted(registry_modules.values()),
            "providers": providers,
        },
        outs = [out],
        tools = {"nu": [CONFIG.TERRAFORM.NUSHELL], "script": [_BUILD_MODULE], "terraform": [toolchain]},
        cmd = "\n".join([
            _heredoc('"$TMP_DIR/spec.json"', spec),
            '"$TOOLS_NU" --no-config-file "$TOOLS_SCRIPT" "$TMP_DIR/spec.json" "$OUT" "$TOOLS_TERRAFORM"',
        ]),
        building_description = "Validating...",
        visibility = visibility,
        labels = labels + ["terraform_module"],
    )


def terraform_module(name:str, srcs:list, version:str=None, toolchain:str=None, deps:dict={}, dep_sources:dict={},
                     registry_modules:dict={}, providers:list=[], local_providers:list=[], visibility:list=None,
                     labels:list=[]):
    """A reusable Terraform module: its own files, plus its `deps`' files, which
    building validates (`terraform init && terraform validate`, against the
    offline provider mirror) with its own pinned Terraform version.

    Each rule's `version` only pins its own validation - a module pinned to
    1.4.0 can be a dep of a root pinned to 1.6.0; each validates its whole
    tree with its own version.

    Args:
      name: Name of the rule.
      srcs: This module's own files - srcs[0] directly inside its directory.
      version: The Terraform version to validate it with - any release in the
               plugin's checksum mirror. Set this or `toolchain`.
      toolchain: A terraform_toolchain to validate it with instead, e.g. for a
                 fork like OpenTofu.
      deps: Other terraform_module rules this module references via local
            (relative-path) `source = ...` module blocks, keyed by the local
            module call's name - e.g. `{"network": "//path:network"}` for a
            `module "network" { source = "../network" }` block.
      dep_sources: The exact `source = "..."` string, as written in this
                   module's own .tf, for each `deps` entry with
                   `registry_modules` (at any depth) beneath it - e.g.
                   `{"network": "../network"}`. Terraform's manifest needs it
                   to match exactly, or it re-discovers that module and
                   un-hermetically re-fetches everything beneath it.
      registry_modules: Third-party modules (terraform_registry_module rules)
                        this module's own .tf files call, keyed by the module
                        call's name - e.g. `{"label": "//third_party/terraform:label"}`.
      providers: Provider plugins (terraform_provider/terraform_local_provider
                 rules) to add to the offline mirror, as well as the plugin's
                 `DefaultProviders`.
      local_providers: The same as `providers` - for terraform_local_provider rules.
      visibility: Visibility declaration of the rule.
      labels: Labels to apply to this rule.
    """
    return _module_rule(
        name = name,
        out = name,
        srcs = srcs,
        deps = deps,
        dep_sources = dep_sources,
        registry_modules = registry_modules,
        providers = providers + local_providers,
        toolchain = _toolchain(version, toolchain),
        validate = True,
        visibility = visibility,
        labels = labels,
    )


def _runtime_paths(label:str) -> dict:
    # Where a rule's output will be at runtime: staged next to a test (or for
    # `plz run --in_tmp_dir`), or in plz-out for a plain `plz run` - see
    # scripts/runner.nu.
    return {"rt": f"$(location {label})", "repo": f"$(out_location {label})"}


def _root_launcher(name:str, config:str, runtime:list, test:bool=False, test_args:list=[], timeout:int=0,
                   flaky:bool|int=0, size:str=None, sandbox:bool=None, visibility:list=None, labels:list=[]):
    nu = CONFIG.TERRAFORM.NUSHELL
    replacements = {
        "__NU_RT__": f"$(location {nu})",
        "__RUNNER_RT__": f"$(location {_RUNNER})",
        "__CONFIG_RT__": f"$(location {config})",
        "__NU__": f"$(out_exe {nu})",
        "__RUNNER__": f"$(out_location {_RUNNER})",
        "__CONFIG__": f"$(out_location {config})",
    }
    launcher = "\n".join([
        "#!/bin/sh",
        "# Generated by the terraform Please plugin: runs scripts/runner.nu.",
        'case "$0" in /*) self="$0" ;; *) self="$PWD/$0" ;; esac',
        "# Staged runtime files (plz test, or plz run --in_tmp_dir): next to this",
        "# launcher, or in a test's working directory.",
        'for staged in "${self%/*}" "$PWD"; do',
        '  if [ -e "$staged/__RUNNER_RT__" ]; then',
        '    exec "$staged/__NU_RT__" --no-config-file "$staged/__RUNNER_RT__" "$staged" staged "$staged/__CONFIG_RT__" "$@"',
        "  fi",
        "done",
        "# Otherwise (a plain plz run), relative to the repository root - which",
        "# Please always runs this from under, in plz-out.",
        'root="${self%%/plz-out/*}"',
        'if [ "$root" = "$self" ]; then',
        '  echo "ERROR: run $self with plz run/plz test" >&2',
        "  exit 1",
        "fi",
        'exec "$root/__NU__" --no-config-file "$root/__RUNNER__" "$root" repo "$root/__CONFIG__" "$@"',
        "",
    ])
    # Each value goes through a shell variable first: Please can give a built
    # file's path as an absolute one, which is made relative to the
    # repository root instead.
    cmd = [_heredoc('"$TMP_DIR/launcher.sh"', launcher)]
    sed = []
    i = 0
    for placeholder, value in replacements.items():
        var = "v" + str(i)
        cmd += [
            var + '="' + value + '"',
            'case "$' + var + '" in /*/plz-out/*) ' + var + '="plz-out/${' + var + '#*/plz-out/}" ;; esac',
        ]
        sed += ['-e "s#' + placeholder + "#$" + var + '#g"']
        i += 1
    cmd += ["sed " + " ".join(sed) + ' "$TMP_DIR/launcher.sh" > "$OUT"']

    return build_rule(
        name = name,
        outs = [name],
        deps = [_RUNNER, config],
        tools = [nu],
        runtime_deps = runtime + [nu.split("|")[0], _RUNNER, config],
        cmd = "\n".join(cmd),
        binary = True,
        test = test,
        test_cmd = " ".join(["$TEST"] + [_shell_quote(arg) for arg in test_args]) if test else None,
        no_test_output = test,
        test_timeout = timeout,
        flaky = flaky,
        size = size,
        test_sandbox = sandbox,
        building_description = "Generating launcher...",
        visibility = visibility,
        labels = labels,
    )


def terraform_root(name:str, srcs:list, version:str=None, toolchain:str=None, deps:dict={}, dep_sources:dict={},
                   registry_modules:dict={}, providers:list=[], local_providers:list=[], env:dict={},
                   env_labels:dict={}, visibility:list=None, labels:list=[]):
    """A Root Terraform Module: a terraform_module that's also runnable - `plz run
    //path:name -- plan` (or `init`, `apply`, ...) runs its pinned Terraform
    version against it, with the offline provider mirror and any registry
    modules set up.

    `plz run` copies the module's tree into a writable scratch directory
    (under plz-out/terraform/, never the source tree) and hands off to a
    script there: the plugin's built-in one - `init` first for plan/apply/
    destroy/validate/refresh/import/console/output, then `terraform` itself -
    or the plugin's `DefaultScript`, if that's set (see the README's Custom
    workflows section).

    Args:
      name: Name of the rule.
      srcs: This module's own files - srcs[0] directly inside its directory.
      version: The Terraform version to validate and run it with - any release
               in the plugin's checksum mirror. Set this or `toolchain`.
      toolchain: A terraform_toolchain to use instead, e.g. for OpenTofu.
      deps: As for terraform_module.
      dep_sources: As for terraform_module.
      registry_modules: As for terraform_module.
      providers: As for terraform_module.
      local_providers: As for terraform_module.
      env: Environment variables set for `plz run`/terraform_root_test - fixed
           config for this root (e.g. TF_LOG), taking precedence over the
           invoking shell's.
      env_labels: Like `env`, but each value is a rule with one output, whose
                  path the variable is set to.
      visibility: Visibility declaration of the rules.
      labels: Labels to apply to the rules.
    """
    for var in env.keys() + env_labels.keys():
        if var in _RESERVED_ENV_NAMES:
            fail(f'terraform_root\'s env/env_labels can\'t set "{var}" - the runner sets it itself')
        if var in env and var in env_labels:
            fail(f'"{var}" is in both terraform_root\'s env and env_labels - remove it from one')

    tf = _toolchain(version, toolchain)
    module = _module_rule(
        name = f"_{name}#module",
        out = f"{name}_module",
        srcs = srcs,
        deps = deps,
        dep_sources = dep_sources,
        registry_modules = registry_modules,
        providers = providers + local_providers,
        toolchain = tf,
        validate = True,
        visibility = visibility,
        labels = labels,
    )

    script = CONFIG.TERRAFORM.DEFAULT_SCRIPT
    all_providers = providers + local_providers + CONFIG.TERRAFORM.DEFAULT_PROVIDERS
    label = canonicalise(f":{name}")
    config_json = json({
        "label": label,
        "name": name,
        "package": package_name(),
        "version": version or "",
        "terraform": _runtime_paths(tf),
        "module": _runtime_paths(module),
        "providers": [_runtime_paths(provider) for provider in all_providers],
        "script": _runtime_paths(script) if script else None,
        "env": env,
        "env_labels": {var: _runtime_paths(target) for var, target in env_labels.items()},
    })
    runtime = [tf, module] + all_providers + env_labels.values() + ([script] if script else [])
    config = build_rule(
        name = f"_{name}#config",
        outs = [f"{name}.tfroot.json"],
        deps = runtime,
        cmd = _heredoc('"$OUT"', config_json),
        building_description = "Writing config...",
        visibility = visibility,
        labels = labels,
    )

    return _root_launcher(
        name = name,
        config = config,
        runtime = runtime,
        visibility = visibility,
        labels = labels + ["terraform_root"],
    )


def terraform_root_test(name:str, root:str, tf_args:list=["plan", "-input=false", "-no-color"], timeout:int=0,
                        flaky:bool|int=0, size:str=None, sandbox:bool=None, visibility:list=None, labels:list=[]):
    """Runs `terraform plan` (or whatever `tf_args` says) against a
    terraform_root, as a test - passing iff that command exits 0.

    It runs with only its runtime files available - so with `sandbox = True`
    (no network), a pass also shows the root needs nothing from the network:
    its provider mirror, registry modules and auto-`init` are all hermetic.

    Args:
      name: Name of the rule.
      root: The terraform_root to run.
      tf_args: Its arguments - what `plz run <root> -- <tf_args...>` would get.
      timeout: Maximum length of time, in seconds, to allow the test to run for.
      flaky: True to mark this as flaky and automatically rerun.
      size: Test size (enormous, large, medium or small).
      sandbox: Sandbox the test on Linux to restrict access to namespaces such as network.
      visibility: Visibility declaration of the rule.
      labels: Labels to apply to this rule.
    """
    return build_rule(
        name = name,
        outs = [f"{name}.sh"],
        data = [root],
        cmd = 'echo "# Runs the terraform_root in data." > "$OUT"',
        test = True,
        test_cmd = " ".join([f'"$(location {root})"'] + [_shell_quote(arg) for arg in tf_args]),
        no_test_output = True,
        test_timeout = timeout,
        flaky = flaky,
        size = size,
        test_sandbox = sandbox,
        visibility = visibility,
        labels = labels + ["terraform_root_test"],
    )
