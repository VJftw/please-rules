"""Build rules for running Nushell (https://www.nushell.sh/) scripts."""

# NUSHELL_VERSIONS: Nushell's release checksums, keyed by version and then by
# `<os>_<arch>` - the default hashes for a version nushell_tool isn't given
# `hashes` for. Generated by .github/scripts/mirrors/nushell.nu.
subinclude("//build_defs:versions")

_RUNFILES_LIB = "///nushell//runfiles:runfiles"

# Please's `<os>_<arch>` to the Rust target triple Nushell's release archives
# are named after. The Linux ones are the fully static musl builds, so they
# don't depend on the host's libc.
_TRIPLES = {
    "linux_amd64": "x86_64-unknown-linux-musl",
    "linux_arm64": "aarch64-unknown-linux-musl",
    "darwin_amd64": "x86_64-apple-darwin",
    "darwin_arm64": "aarch64-apple-darwin",
}

# Runs a Nushell script with nu. Please stages a test's (or `plz run
# --in_tmp_dir`'s) runtime files - nu, the script, its libraries and
# runfiles.nu, which the rules below make runtime data - right next to it, at
# their package paths, which also works in a sandboxed test. Without that (a
# plain `plz run`), they're found relative to the repository root instead -
# derived from the launcher's own path, since Please always runs a binary
# from under plz-out. __NU_RT__/__SRC_RT__/__LIB_RT__ (staged paths) and
# __NU__/__SRC__/__LIB__ (paths relative to the repository root) are filled in
# by the rule's build command.
#
# PLZ_NU_RUNFILES_ROOTS tells runfiles.nu where to look for runtime files.
_LAUNCHER = """#!/bin/sh
# Generated by the nushell Please plugin: runs a Nushell script with nu.
case "$0" in
  /*) self="$0" ;;
  *) self="$PWD/$0" ;;
esac
rs="$(printf '\\036')"

staged="${self%/*}"
if [ -e "$staged/__SRC_RT__" ]; then
  nu="__NU_RT__"
  src="$staged/__SRC_RT__"
  lib="$staged/__LIB_RT__"
  # Modules can be `use`d relative to the repository root.
  include_path="$staged"
  root="$staged"
  PLZ_NU_RUNFILES_ROOTS="$staged"
else
  root="${self%%/plz-out/*}"
  if [ "$root" = "$self" ]; then
    echo "ERROR: can't find __SRC__ - run $self with plz run/plz test" >&2
    exit 1
  fi
  nu="__NU__"
  src="$root/__SRC__"
  lib="$root/__LIB__"
  # Modules can be `use`d relative to the repository root, whether they're
  # source files or generated ones.
  include_path="$root$rs$root/plz-out/gen"
  PLZ_NU_RUNFILES_ROOTS="$root$rs$root/plz-out/gen$rs$root/plz-out/bin"
fi
export PLZ_NU_RUNFILES_ROOTS

# A path to a nu built by Please (rather than a command on PATH).
case "$nu" in
  */*) nu="$root/$nu" ;;
esac

exec "$nu" --no-config-file --include-path "$include_path$rs${lib%/*}" "$src" "$@"
"""


def nushell_tool(name:str, version:str, hashes:list=None, url_template:str=None, visibility:list=None, labels:list=[]):
    """Downloads Nushell for the host platform from GitHub Releases.

    The resulting target's `nu` entry point can be used as the plugin's `Tool`,
    e.g. `//third_party/nushell:nu|nu`.

    Args:
      name: Name of the rule.
      version: The Nushell version to download, e.g. "0.116.0".
      hashes: Hashes to verify the downloaded archive with. Defaults to the
              host platform's hash for `version` in the plugin's checksum
              mirror (build_defs/versions.build_defs), if it's there and
              `url_template` isn't set.
      url_template: Downloads from here instead of GitHub Releases - with
                    `{version}` and `{asset}` (Nushell's own release filename,
                    e.g. `nu-0.116.0-x86_64-unknown-linux-musl.tar.gz`)
                    placeholders.
      visibility: Visibility declaration of the rule.
      labels: Labels to apply to this rule.
    """
    platform = f"{CONFIG.OS}_{CONFIG.ARCH}"
    if platform not in _TRIPLES:
        fail(f"Nushell doesn't publish a build for {platform} that this plugin knows about. Set the nushell plugin's `Tool` config to a nu executable you provide instead.")

    if hashes == None:
        # The mirror's checksums are for Nushell's own release archives - so
        # meaningless for one fetched from somewhere else.
        known = None if url_template else NUSHELL_VERSIONS.get(version, {}).get(platform)
        hashes = [f"sha256: {known}"] if known else []

    triple = _TRIPLES[platform]
    asset = f"nu-{version}-{triple}.tar.gz"
    template = url_template or "https://github.com/nushell/nushell/releases/download/{version}/{asset}"
    return remote_file(
        name = name,
        url = template.format(version = version, asset = asset),
        hashes = hashes,
        extract = True,
        strip_prefix = f"nu-{version}-{triple}",
        binary = True,
        entry_points = {"nu": "nu"},
        visibility = visibility,
        labels = labels,
    )


def nu_library(name:str, srcs:list=[], deps:list=[], visibility:list=None, labels:list=[]):
    """A reusable set of Nushell modules (or scripts), `use`d/`source`d by
    `nu_binary`/`nu_test` rules and other `nu_library` rules that list it in
    their `deps`.

    Its own `deps` are exported, so a rule that depends on a library only needs
    to list that library, not everything it transitively `use`s.

    Args:
      name: Name of the rule.
      srcs: This library's own `.nu` files.
      deps: Other nu_library rules that `srcs` `use`/`source`.
      visibility: Visibility declaration of the rule.
      labels: Labels to apply to this rule.
    """
    srcs_rule = filegroup(
        name = f"_{name}#srcs",
        srcs = srcs,
        visibility = visibility,
    )

    # Like a filegroup of `srcs` exporting `deps`, except that everything is
    # also a runtime dependency, so a test's (transitive) libraries are
    # staged alongside it - see _LAUNCHER. Please only allows runtime
    # dependencies on binary rules; this one has no outputs of its own, so
    # being "binary" doesn't mean anything else.
    return build_rule(
        name = name,
        exported_deps = [srcs_rule] + deps,
        runtime_deps = [srcs_rule] + deps,
        binary = True,
        visibility = visibility,
        labels = labels + ["nushell"],
    )


def _shell_quote(arg:str) -> str:
    return "'" + arg.replace("'", "'\\''") + "'"


def _nu_launcher(name:str, src:str, deps:list, data:list, visibility:list, labels:list, test:bool=False,
                 args:list=[], timeout:int=0, flaky:bool|int=0, size:str=None, sandbox:bool=None):
    tool = CONFIG.NUSHELL.TOOL
    runtime = [src] + deps
    if looks_like_build_label(tool):
        # Built by Please (in this plugin, or the host repository).
        nu_rt = f"$(location {tool})"
        nu = f"$(out_exe {tool})"
        tools = [tool]
        runtime += [tool.split("|")[0]]
    else:
        # A command on the host's PATH.
        nu_rt = tool
        nu = tool
        tools = []

    if looks_like_build_label(src):
        src_rt = f"$(location {src})"
        src_path = f"$(out_location {src})"
    else:
        src_rt = join_path(package_name(), src)
        src_path = src_rt

    runtime += [_RUNFILES_LIB]
    replacements = {
        "__NU_RT__": nu_rt,
        "__SRC_RT__": src_rt,
        "__LIB_RT__": f"$(location {_RUNFILES_LIB})",
        "__NU__": nu,
        "__SRC__": src_path,
        "__LIB__": f"$(out_location {_RUNFILES_LIB})",
    }

    # Each value goes through a shell variable first: Please can give a built
    # file's path as an absolute one, which is made relative to the
    # repository root instead, so the launcher doesn't depend on where the
    # repository is. A heredoc's terminator has to be on a line of its own.
    cmd = [f"cat > \"$TMP_DIR/launcher.sh\" << 'EOF'\n{_LAUNCHER}EOF"]
    sed = []
    i = 0
    for placeholder, value in replacements.items():
        var = "v" + str(i)
        cmd += [
            var + '="' + value + '"',
            'case "$' + var + '" in /*/plz-out/*) ' + var + '="plz-out/${' + var + '#*/plz-out/}" ;; esac',
        ]
        sed += ['-e "s#' + placeholder + "#$" + var + '#g"']
        i += 1
    cmd += ["sed " + " ".join(sed) + ' "$TMP_DIR/launcher.sh" > "$OUT"']
    cmd = "\n".join(cmd)

    return build_rule(
        name = name,
        srcs = [src],
        outs = [name],
        deps = deps + [_RUNFILES_LIB],
        data = data + runtime,
        tools = tools,
        cmd = cmd,
        binary = True,
        test = test,
        test_cmd = " ".join(["$TEST"] + [_shell_quote(arg) for arg in args]) if test else None,
        no_test_output = test,
        test_timeout = timeout,
        flaky = flaky,
        size = size,
        test_sandbox = sandbox,
        building_description = "Generating launcher...",
        visibility = visibility,
        labels = labels + ["nushell"],
    )


def nu_binary(name:str, src:str, deps:list=[], data:list=[], visibility:list=None, labels:list=[]):
    """A Nushell script, runnable with `plz run //path:name -- <args...>`.

    Runs `nu --no-config-file <src> <args...>` with the plugin's `Tool`, so the
    script behaves the same regardless of the invoking user's own Nushell
    config. Any `def main [...]` it defines is called with those arguments.

    A module can be `use`d relative to `src` (e.g. `use ../lib/greeting.nu`)
    or relative to the repository root (e.g. `use lib/greeting.nu`) - list
    the nu_library rules it `use`s in `deps`, so they're built. It can also
    `use runfiles.nu` to find its `data`, with `runfiles rlocation <path>`
    (relative to the repository root).

    Args:
      name: Name of the rule.
      src: The Nushell script to run.
      deps: nu_library rules `src` `use`s/`source`s.
      data: Runtime data for the script.
      visibility: Visibility declaration of the rule.
      labels: Labels to apply to this rule.
    """
    return _nu_launcher(
        name = name,
        src = src,
        deps = deps,
        data = data,
        visibility = visibility,
        labels = labels,
    )


def nu_test(name:str, src:str, deps:list=[], data:list=[], args:list=[], timeout:int=0, flaky:bool|int=0,
            size:str=None, sandbox:bool=None, visibility:list=None, labels:list=[]):
    """A Nushell script run as a test - passes iff `nu --no-config-file <src>
    <args...>` exits 0, so an uncaught error (e.g. a failed assertion from
    Nushell's own `std/assert` module) fails it.

    As with any Please test, it runs from its own test directory, where `data`
    is available at its usual path relative to the repository root - or use
    `runfiles.nu`, as for nu_binary, which works the same either way.

    Args:
      name: Name of the rule.
      src: The Nushell test script.
      deps: nu_library rules `src` `use`s/`source`s.
      data: Runtime data for the test.
      args: Arguments to pass to the script's `def main`.
      timeout: Maximum length of time, in seconds, to allow the test to run for.
      flaky: True to mark this as flaky and automatically rerun.
      size: Test size (enormous, large, medium or small).
      sandbox: Sandbox the test on Linux to restrict access to namespaces such as network.
      visibility: Visibility declaration of the rule.
      labels: Labels to apply to this rule.
    """
    return _nu_launcher(
        name = name,
        src = src,
        deps = deps,
        data = data,
        test = True,
        args = args,
        timeout = timeout,
        flaky = flaky,
        size = size,
        sandbox = sandbox,
        visibility = visibility,
        labels = labels,
    )


def nu_genrule(name:str, src:str, outs:list, srcs:list=[], deps:list=[], args:list=[], visibility:list=None,
               labels:list=[]):
    """Runs a Nushell script as a build action - `nu --no-config-file <src>
    <args...>` - to produce `outs`.

    It runs in the build's own temporary directory, where `srcs` (and `deps`'
    outputs) are at their usual paths relative to the repository root - which
    is also on the include path, so `src` can `use` a nu_library in `deps` as
    it would in a nu_binary. `args` are passed through a shell first, so
    Please's usual build variables work in them, e.g. `$OUTS` or
    `$(location :foo)`.

    Args:
      name: Name of the rule.
      src: The Nushell script to run.
      outs: The files the script creates.
      srcs: Files the script reads.
      deps: nu_library rules `src` `use`s/`source`s, or other rules whose outputs it needs.
      args: Arguments to pass to the script's `def main`.
      visibility: Visibility declaration of the rule.
      labels: Labels to apply to this rule.
    """
    tool = CONFIG.NUSHELL.TOOL
    return build_rule(
        name = name,
        srcs = {"src": [src], "srcs": srcs},
        outs = outs,
        deps = deps,
        tools = [tool],
        cmd = " ".join(['"$TOOL" --no-config-file --include-path "$TMP_DIR" "$SRCS_SRC"'] + args),
        building_description = "Running...",
        visibility = visibility,
        labels = labels + ["nushell"],
    )
