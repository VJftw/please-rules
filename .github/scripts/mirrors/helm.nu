# Regenerates k8s/build_defs/helm_versions.build_defs: a GPG-verified mirror
# of Helm 3.x release checksums, used by helm_tool as the default hashes for
# a version it isn't given `hashes` for.
#
# Shells out to a real `gpg` binary on PATH for signature verification. Helm
# doesn't publish a plain checksums manifest as a GitHub release asset (only
# detached `.asc` signatures) - the plain per-platform `<archive>.sha256`
# lives at get.helm.sh itself, verified here against the matching
# `<archive>.sha256.asc` detached signature from the GitHub release, using
# Helm's own published `KEYS` file. Bounded to the 3.x line. Incremental -
# see mirror.nu.
#
#   cd .github && plz run //scripts/mirrors:helm

use scripts/mirrors/mirror.nu

const GET_HELM_BASE_URL = "https://get.helm.sh"
const HELM_KEYS_URL = "https://raw.githubusercontent.com/helm/helm/main/KEYS"
const MAJOR = "3"

# Every platform helm publishes a release for - not just the ones helm_tool
# supports, so the mirror stays useful even if that set grows later.
const PLATFORMS = [
    darwin-amd64
    darwin-arm64
    linux-386
    linux-amd64
    linux-arm
    linux-arm64
    linux-loong64
    linux-ppc64le
    linux-riscv64
    linux-s390x
    windows-amd64
    windows-arm64
]

def archive-ext [platform: string]: nothing -> string {
    if ($platform | str starts-with "windows-") { "zip" } else { "tar.gz" }
}

def import-helm-keys [gnupg_home: string] {
    # Fetched fresh each run rather than hardcoded, so a key rotation/new
    # maintainer doesn't silently break this.
    let keys = (mirror fetch $HELM_KEYS_URL)
    with-env {GNUPGHOME: $gnupg_home} {
        $keys | ^gpg --quiet --import
    }
}

# Fetches + GPG-verifies `version`/`platform`'s sha256. Returns the hex
# digest, or null if unavailable/unverifiable.
def fetch-verified-sha256 [version: string, platform: string, gnupg_home: string]: nothing -> any {
    let archive = $"helm-v($version)-($platform).(archive-ext $platform)"
    let fetched = (try {
        {
            sha256_raw: (mirror fetch $"($GET_HELM_BASE_URL)/($archive).sha256")
            sig: (mirror fetch $"https://github.com/helm/helm/releases/download/v($version)/($archive).sha256.asc")
        }
    } catch {
        null
    })
    if $fetched == null {
        print --stderr $"> No sha256/signature for helm ($version) ($platform), skipping"
        return null
    }

    let dir = (mktemp --directory)
    let sum_path = ($dir | path join sum)
    let sig_path = ($dir | path join sum.asc)
    # The signature is over the exact bytes of the fetched .sha256 file -
    # write it back out unmodified: gpg verification is byte-exact.
    $fetched.sha256_raw | save --raw $sum_path
    $fetched.sig | save --raw $sig_path
    let result = (with-env {GNUPGHOME: $gnupg_home} {
        ^gpg --verify $sig_path $sum_path | complete
    })
    rm --recursive --force $dir

    if not ($result.stderr | str contains "Good signature") {
        print --stderr $"> Could not verify signature for helm ($version) ($platform), skipping"
        return null
    }
    $fetched.sha256_raw | decode utf-8 | split words | first
}

def main [] {
    let file = ([(mirror repo-root) k8s build_defs helm_versions.build_defs] | path join)
    let existing = (mirror load-existing $file HELM_VERSIONS)
    print --stderr $"($existing | columns | length) versions already mirrored"

    let gnupg_home = (mktemp --directory)
    import-helm-keys $gnupg_home

    let versions = (mirror list-new-github-versions helm/helm ($existing | columns) {|releases|
        $releases
        | get tag_name
        | parse --regex ('^v(?<version>' + $MAJOR + '\.[0-9]+\.[0-9]+)$')
        | get version
    })
    print --stderr $"Found ($versions | length) Helm ($MAJOR).x release\(s\) not mirrored yet"

    let new_entries = ($versions | reduce --fold {} {|version, acc|
        print --stderr $"Processing Helm ($version)..."
        let platform_shas = ($PLATFORMS | reduce --fold {} {|platform, shas|
            let sha256 = (fetch-verified-sha256 $version $platform $gnupg_home)
            if $sha256 == null { $shas } else { $shas | insert ($platform | str replace "-" "_") $sha256 }
        })
        if ($platform_shas | is-empty) { $acc } else { $acc | insert $version $platform_shas }
    })
    rm --recursive --force $gnupg_home

    mirror write-mirror $file HELM_VERSIONS [
        "GENERATED by `cd .github && plz run //scripts/mirrors:helm` - see"
        ".github/scripts/mirrors/helm.nu."
        ""
        $"GPG-verified Helm ($MAJOR).x release checksums - get.helm.sh's <archive>.sha256,"
        "checked against the GitHub release's <archive>.sha256.asc signature with Helm's"
        "own KEYS file: helm_tool's default hashes for a version it isn't given `hashes` for."
    ] ($new_entries | merge $existing)
}
