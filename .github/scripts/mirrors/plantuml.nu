# Regenerates plantuml/build_defs/versions.build_defs: a mirror of PlantUML
# jar checksums, used by the plantuml plugin as the default hash for a
# `ToolVersion` without one of its own.
#
# Maven Central doesn't publish a `.sha256`/`.sha1`/`.asc` file for this
# artifact at all - so there's no checksum or signature to merely fetch: this
# downloads each new version's actual jar and hashes it locally instead.
# Incremental: only versions not already in the file are downloaded (Maven's
# version listing is a single small file, so there's no need to stop early
# as the GitHub-based mirrors do).
#
#   cd .github && plz run //scripts/mirrors:plantuml

use scripts/mirrors/mirror.nu

const MAVEN_BASE_URL = "https://repo1.maven.org/maven2/net/sourceforge/plantuml/plantuml"

def list-versions []: nothing -> list<string> {
    mirror fetch $"($MAVEN_BASE_URL)/maven-metadata.xml"
    | decode utf-8
    | parse --regex '<version>(?<version>[^<]+)</version>'
    | get version
}

def hash-jar [version: string]: nothing -> any {
    try {
        mirror fetch $"($MAVEN_BASE_URL)/($version)/plantuml-($version).jar" | hash sha256
    } catch {
        print --stderr $"> No jar for PlantUML ($version), skipping"
        null
    }
}

def main [] {
    let file = ([(mirror repo-root) plantuml build_defs versions.build_defs] | path join)
    let existing = (mirror load-existing $file PLANTUML_VERSIONS)
    print --stderr $"($existing | columns | length) versions already mirrored"

    # Maven lists versions oldest first - newest first, like the others.
    let versions = (list-versions | reverse | where {|v| $v not-in ($existing | columns) })
    print --stderr $"Found ($versions | length) PlantUML release\(s\) not mirrored yet"

    let new_entries = ($versions | reduce --fold {} {|version, acc|
        print --stderr $"Processing PlantUML ($version)..."
        let sha256 = (hash-jar $version)
        if $sha256 == null { $acc } else { $acc | insert $version $sha256 }
    })

    mirror write-mirror $file PLANTUML_VERSIONS [
        "GENERATED by `cd .github && plz run //scripts/mirrors:plantuml` - see"
        ".github/scripts/mirrors/plantuml.nu."
        ""
        "PlantUML jar checksums - Maven Central publishes none for this artifact,"
        "so each was computed by downloading and hashing the jar: the plantuml"
        "plugin's default hash for a `ToolVersion` without one of its own."
    ] ($new_entries | merge $existing)
}
