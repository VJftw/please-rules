# Regenerates k8s/build_defs/kustomize_versions.build_defs: a mirror of
# kustomize 5.x release checksums, used by kustomize_tool as the default
# hashes for a version it isn't given `hashes` for.
#
# Plain HTTPS-fetched from kustomize's own release `checksums.txt` - not
# GPG-verified, as kustomize doesn't publish a signature for it. Bounded to
# the 5.x line - extend `MAJOR` below once kustomize ships a 6.x.
# Incremental - see mirror.nu.
#
#   cd .github && plz run //scripts/mirrors:kustomize

use scripts/mirrors/mirror.nu

const MAJOR = "5"

def fetch-checksums [version: string]: nothing -> any {
    let url = $"https://github.com/kubernetes-sigs/kustomize/releases/download/kustomize/v($version)/checksums.txt"
    try {
        mirror fetch $url | decode utf-8
    } catch {
        print --stderr $"> No checksums.txt for ($version), skipping"
        null
    }
}

# {platform: sha256}, e.g. {linux_amd64: ...}, from a checksums.txt.
def parse-platform-shas []: string -> record {
    lines
    | where {|line| ($line | str trim) != "" }
    | parse --regex '^(?<sha256>\S+)\s+kustomize_v[0-9.]+_(?<platform>.+)\.(?:tar\.gz|zip)\s*$'
    | reduce --fold {} {|row, acc| $acc | upsert $row.platform $row.sha256 }
}

def main [] {
    let file = ([(mirror repo-root) k8s build_defs kustomize_versions.build_defs] | path join)
    let existing = (mirror load-existing $file KUSTOMIZE_VERSIONS)
    print --stderr $"($existing | columns | length) versions already mirrored"

    let versions = (mirror list-new-github-versions kubernetes-sigs/kustomize ($existing | columns) {|releases|
        $releases
        | get tag_name
        | parse --regex ('^kustomize/v(?<version>' + $MAJOR + '\.[0-9]+\.[0-9]+)$')
        | get version
    })
    print --stderr $"Found ($versions | length) kustomize ($MAJOR).x release\(s\) not mirrored yet"

    let new_entries = ($versions | reduce --fold {} {|version, acc|
        print --stderr $"Processing kustomize ($version)..."
        let checksums = (fetch-checksums $version)
        if $checksums == null { $acc } else { $acc | insert $version ($checksums | parse-platform-shas) }
    })

    mirror write-mirror $file KUSTOMIZE_VERSIONS [
        "GENERATED by `cd .github && plz run //scripts/mirrors:kustomize` - see"
        ".github/scripts/mirrors/kustomize.nu."
        ""
        $"kustomize ($MAJOR).x release checksums, from kustomize's own release checksums.txt:"
        "kustomize_tool's default hashes for a version it isn't given `hashes` for."
    ] ($new_entries | merge $existing)
}
