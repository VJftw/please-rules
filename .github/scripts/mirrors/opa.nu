# Regenerates opa/build_defs/versions.build_defs: a mirror of OPA 1.x release
# checksums, used by opa_tool as the default hashes for a version it isn't
# given `hashes` for.
#
# Plain HTTPS-fetched, not signature-verified: OPA doesn't publish a GPG
# signature (or a sigstore/cosign one) alongside its per-binary `.sha256`
# files. Bounded to the 1.x line (OPA's pre-1.0 releases used a meaningfully
# different versioning scheme). Incremental - see mirror.nu.
#
#   cd .github && plz run //scripts/mirrors:opa

use scripts/mirrors/mirror.nu

const MAJOR = "1"

# Matches opa_tool's own asset names - kept in sync by hand.
const ASSET_NAMES = {
    linux_amd64: "opa_linux_amd64_static"
    linux_arm64: "opa_linux_arm64_static"
    darwin_amd64: "opa_darwin_amd64"
    darwin_arm64: "opa_darwin_arm64"
    windows_amd64: "opa_windows_amd64.exe"
}

def fetch-sha256 [version: string, platform: string]: nothing -> any {
    let asset = ($ASSET_NAMES | get $platform)
    let url = $"https://github.com/open-policy-agent/opa/releases/download/v($version)/($asset).sha256"
    try {
        mirror fetch $url | decode utf-8 | split words | first
    } catch {
        print --stderr $"> No sha256 for opa ($version) ($platform), skipping"
        null
    }
}

def main [] {
    let file = ([(mirror repo-root) opa build_defs versions.build_defs] | path join)
    let existing = (mirror load-existing $file OPA_VERSIONS)
    print --stderr $"($existing | columns | length) versions already mirrored"

    let versions = (mirror list-new-github-versions open-policy-agent/opa ($existing | columns) {|releases|
        $releases
        | where {|r| not $r.prerelease }
        | get tag_name
        | parse --regex ('^v(?<version>' + $MAJOR + '\.[0-9]+\.[0-9]+)$')
        | get version
    })
    print --stderr $"Found ($versions | length) OPA ($MAJOR).x release\(s\) not mirrored yet"

    let new_entries = ($versions | reduce --fold {} {|version, acc|
        print --stderr $"Processing OPA ($version)..."
        let platform_shas = ($ASSET_NAMES | columns | reduce --fold {} {|platform, shas|
            let sha256 = (fetch-sha256 $version $platform)
            if $sha256 == null { $shas } else { $shas | insert $platform $sha256 }
        })
        if ($platform_shas | is-empty) { $acc } else { $acc | insert $version $platform_shas }
    })

    mirror write-mirror $file OPA_VERSIONS [
        "GENERATED by `cd .github && plz run //scripts/mirrors:opa` - see"
        ".github/scripts/mirrors/opa.nu."
        ""
        $"OPA ($MAJOR).x release checksums, from OPA's own GitHub release .sha256 files:"
        "opa_tool's default hashes for a version it isn't given `hashes` for."
    ] ($new_entries | merge $existing)
}
