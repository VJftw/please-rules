# Regenerates hugo/build_defs/versions.build_defs: a mirror of the "extended"
# Hugo release variant's checksums, used by hugo_tool as the default hashes
# for a version it isn't given `hashes` for.
#
# Plain HTTPS-fetched from Hugo's own combined `checksums.txt` release asset
# (one file per version, covering every variant/platform - not GPG-verified:
# Hugo doesn't publish a signature for it). Only the "extended" variant's
# entries are kept - the default (and recommended) variant; any other variant
# always needs explicit `hashes`. Incremental - see mirror.nu.
#
#   cd .github && plz run //scripts/mirrors:hugo

use scripts/mirrors/mirror.nu

# Matches hugo_tool's own platforms - kept in sync by hand.
const OS_ARCH_TO_PLATFORM = {
    linux-amd64: "linux_amd64"
    linux-arm64: "linux_arm64"
    darwin-universal: "darwin_universal"
    windows-amd64: "windows_amd64"
    windows-arm64: "windows_arm64"
}

def fetch-checksums [version: string]: nothing -> any {
    let url = $"https://github.com/gohugoio/hugo/releases/download/v($version)/hugo_($version)_checksums.txt"
    try {
        mirror fetch $url | decode utf-8
    } catch {
        print --stderr $"> No checksums.txt for ($version), skipping"
        null
    }
}

def parse-platform-shas []: string -> record {
    lines
    | where {|line| ($line | str trim) != "" }
    | parse --regex '^(?<sha256>\S+)\s+hugo_extended_[0-9.]+_(?<os_arch>.+)\.(?:tar\.gz|zip|pkg)\s*$'
    | where {|row| $row.os_arch in $OS_ARCH_TO_PLATFORM }
    | reduce --fold {} {|row, acc| $acc | upsert ($OS_ARCH_TO_PLATFORM | get $row.os_arch) $row.sha256 }
}

def main [] {
    let file = ([(mirror repo-root) hugo build_defs versions.build_defs] | path join)
    let existing = (mirror load-existing $file HUGO_VERSIONS)
    print --stderr $"($existing | columns | length) versions already mirrored"

    let versions = (mirror list-new-github-versions gohugoio/hugo ($existing | columns) {|releases|
        $releases
        | where {|r| not $r.prerelease }
        | get tag_name
        | parse --regex '^v(?<version>[0-9]+\.[0-9]+\.[0-9]+)$'
        | get version
    })
    print --stderr $"Found ($versions | length) Hugo release\(s\) not mirrored yet"

    let new_entries = ($versions | reduce --fold {} {|version, acc|
        print --stderr $"Processing Hugo ($version)..."
        let checksums = (fetch-checksums $version)
        if $checksums == null { return $acc }
        let platform_shas = ($checksums | parse-platform-shas)
        if ($platform_shas | is-empty) { $acc } else { $acc | insert $version $platform_shas }
    })

    mirror write-mirror $file HUGO_VERSIONS [
        "GENERATED by `cd .github && plz run //scripts/mirrors:hugo` - see"
        ".github/scripts/mirrors/hugo.nu."
        ""
        "The \"extended\" Hugo release variant's checksums, from Hugo's own combined"
        "checksums.txt release asset: hugo_tool's default hashes for a version it"
        "isn't given `hashes` for."
    ] ($new_entries | merge $existing)
}
