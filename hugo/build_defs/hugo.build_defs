"""Build rules for Hugo (https://gohugo.io/) static sites."""

# HUGO_VERSIONS: the "extended" Hugo release variant's checksums, keyed by
# version and then by platform - the default hashes for a version hugo_tool
# isn't given `hashes` for. Generated by .github/scripts/mirrors/hugo.nu.
subinclude("//build_defs:versions")

# Each release variant's infix in Hugo's asset names. "hugo" is the plain
# build (no Sass/SCSS support); "extended" is what most themes expect;
# "extended_withdeploy"/"withdeploy" also bundle `hugo deploy`.
_VARIANT_INFIXES = {
    "hugo": "",
    "extended": "_extended",
    "extended_withdeploy": "_extended_withdeploy",
    "withdeploy": "_withdeploy",
}

# Please's `<os>_<arch>` to Hugo's own platform naming. Darwin is a single
# universal (fat) binary covering both architectures - shipped as a macOS
# .pkg installer (since 0.160.0), not a .tar.gz.
_PLATFORMS = {
    "linux_amd64": ("linux_amd64", "linux-amd64", "tar.gz"),
    "linux_arm64": ("linux_arm64", "linux-arm64", "tar.gz"),
    "darwin_amd64": ("darwin_universal", "darwin-universal", "pkg"),
    "darwin_arm64": ("darwin_universal", "darwin-universal", "pkg"),
}


def _shell_quote(arg:str) -> str:
    return "'" + arg.replace("'", "'\\''") + "'"


def hugo_tool(name:str, version:str, variant:str="extended", hashes:list=None, url_template:str=None,
              visibility:list=None, labels:list=[]):
    """Downloads Hugo for the host platform from GitHub Releases.

    The result can be used as the plugin's `Tool`, e.g. `//third_party/hugo:hugo`.

    Args:
      name: Name of the rule.
      version: The Hugo version to download, e.g. "0.166.0" (without the leading 'v').
      variant: Which release build to download - extended (the default), hugo,
               extended_withdeploy or withdeploy.
      hashes: Hashes to verify the downloaded archive with. Defaults to the host
              platform's hash for `version` in the plugin's checksum mirror
              (build_defs/versions.build_defs), if it's there, `variant` is
              "extended" and `url_template` isn't set.
      url_template: Downloads from here instead of GitHub Releases - with
                    `{version}` and `{asset}` (Hugo's own release filename, e.g.
                    `hugo_extended_0.166.0_linux-amd64.tar.gz`) placeholders.
      visibility: Visibility declaration of the rule.
      labels: Labels to apply to this rule.
    """
    platform = f"{CONFIG.OS}_{CONFIG.ARCH}"
    if platform not in _PLATFORMS:
        fail(f"Hugo doesn't publish a build for {platform} that this plugin knows about. Set the hugo plugin's `Tool` config to a hugo executable you provide instead.")
    if variant not in _VARIANT_INFIXES:
        fail("hugo_tool's variant must be one of " + ", ".join(_VARIANT_INFIXES.keys()) + ", not " + variant)
    mirror_platform = _PLATFORMS[platform][0]
    os_arch = _PLATFORMS[platform][1]
    ext = _PLATFORMS[platform][2]

    if hashes == None:
        # The mirror only covers the "extended" variant's own release archives.
        known = None if url_template or variant != "extended" else HUGO_VERSIONS.get(version, {}).get(mirror_platform)
        hashes = [f"sha256: {known}"] if known else []

    infix = _VARIANT_INFIXES[variant]
    asset = f"hugo{infix}_{version}_{os_arch}.{ext}"
    template = url_template or "https://github.com/gohugoio/hugo/releases/download/v{version}/{asset}"
    download = remote_file(
        name = name,
        _tag = "download",
        url = template.format(version = version, asset = asset),
        out = asset,
        hashes = hashes,
    )

    if ext == "pkg":
        # A macOS installer package - unpacked with macOS's own pkgutil, which
        # is always there on the Mac this is being built for.
        cmd = " && ".join([
            'pkgutil --expand-full "$SRC" "$TMP_DIR/expanded"',
            'cp "$(find "$TMP_DIR/expanded" -type f -name hugo | head -1)" "$OUT"',
        ])
    else:
        cmd = 'mkdir "$TMP_DIR/_extracted" && tar -xzf "$SRC" -C "$TMP_DIR/_extracted" hugo && mv "$TMP_DIR/_extracted/hugo" "$OUT"'

    return build_rule(
        name = name,
        srcs = [download],
        outs = ["hugo"],
        cmd = cmd,
        binary = True,
        building_description = "Extracting...",
        visibility = visibility,
        labels = labels,
    )


def hugo_site(name:str, config:str, srcs:list, base_url:str="", environment:str="production", minify:bool=False,
              extra_args:list=[], out:str=None, visibility:list=None, labels:list=[]):
    """Renders a Hugo site into a directory of static files, and exposes a
    `<name>_hugo` runnable for local preview.

    `<name>` copies `config` and `srcs` into a scratch directory (dereferencing
    any symlinks - Hugo's content/layout walkers silently skip symlinked
    files) and runs `hugo --source <copy> --destination <out> --noBuildLock`
    there. `<name>_hugo` runs the plugin's `Tool` - e.g. `cd path/to/site && plz
    run //path/to:<name>_hugo -- server` for a live-reloading local preview, or
    any other one-off `hugo` subcommand.

    Args:
      name: Name of the rule (and the rendered site's directory).
      config: The site's root Hugo config file (hugo.toml/hugo.yaml/hugo.json,
              or the legacy config.* name) - its directory becomes the site's
              `--source` root.
      srcs: Every other file the site needs - content/, layouts/, static/,
            assets/, data/, i18n/, archetypes/, etc.
      base_url: Passed via `--baseURL`.
      environment: Passed via `--environment` - set explicitly so a build's
                   output doesn't depend on an ambient HUGO_ENVIRONMENT.
      minify: Whether to pass `--minify`.
      extra_args: Extra flags passed through to `hugo`, e.g. '--gc'.
      out: Output directory name. Defaults to `name`.
      visibility: Visibility declaration of the rules.
      labels: Labels to apply to the rules.
    """
    args = ["--environment", environment]
    if base_url:
        args += ["--baseURL", base_url]
    if minify:
        args += ["--minify"]
    args += extra_args

    tool = CONFIG.HUGO.TOOL
    config_dir = join_path(package_name(), dirname(config)) if not looks_like_build_label(config) else None
    if config_dir == None:
        fail("hugo_site's config must be a file in this package")

    site = build_rule(
        name = name,
        srcs = {"config": [config], "srcs": srcs},
        outs = [out or name],
        tools = [tool],
        cmd = " && ".join([
            # Real copies (cp -L), not whatever Please staged the sources as.
            'mkdir -p "$TMP_DIR/_site"',
            'for f in $SRCS; do mkdir -p "$TMP_DIR/_site/$(dirname "$f")" && cp -L "$f" "$TMP_DIR/_site/$f"; done',
            'mkdir -p "$OUT"',
            " ".join([
                '"$TOOL"',
                f'--source "$TMP_DIR/_site/{config_dir}"',
                '--destination "$OUT"',
                "--noBuildLock",
            ] + [_shell_quote(arg) for arg in args]),
        ]),
        building_description = "Building site...",
        visibility = visibility,
        labels = labels + ["hugo"],
    )

    # `plz run` runs this from wherever it was invoked, so hugo picks up the
    # site there (or wherever `--source` points).
    if looks_like_build_label(tool):
        tool_path = f"$(out_exe {tool})"
        tools = [tool]
    else:
        tool_path = tool
        tools = []
    launcher = "\n".join([
        "#!/bin/sh",
        "# Generated by the hugo Please plugin: runs hugo.",
        'case "$0" in /*) self="$0" ;; *) self="$PWD/$0" ;; esac',
        "hugo=__HUGO__",
        # Relative to the repository root - which Please always runs this
        # from under, in plz-out.
        'case "$hugo" in */*) hugo="${self%%/plz-out/*}/$hugo" ;; esac',
        'exec "$hugo" "$@"',
        "",
    ])
    build_rule(
        name = f"{name}_hugo",
        outs = [f"{name}_hugo"],
        tools = tools,
        # Please can give a built tool's path as an absolute one - store it
        # relative to the repository root instead, so the launcher doesn't
        # depend on where the repository is.
        cmd = "\n".join([
            f"cat > \"$TMP_DIR/launcher.sh\" << 'EOF'\n{launcher}EOF",
            f'hugo="{tool_path}"',
            'case "$hugo" in /*/plz-out/*) hugo="plz-out/${hugo#*/plz-out/}" ;; esac',
            'sed -e "s#__HUGO__#$hugo#" "$TMP_DIR/launcher.sh" > "$OUT"',
        ]),
        binary = True,
        building_description = "Generating launcher...",
        visibility = visibility,
        labels = labels + ["hugo"],
    )
    return site
