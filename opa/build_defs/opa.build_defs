"""Build rules for Open Policy Agent (https://www.openpolicyagent.org/) policies."""

# OPA_VERSIONS: OPA's release checksums, keyed by version and then by
# `<os>_<arch>` - the default hashes for a version opa_tool isn't given
# `hashes` for. Generated by .github/scripts/mirrors/opa.nu.
subinclude("//build_defs:versions")

# OPA's own release asset names for each `<os>_<arch>` - the Linux builds are
# the fully static ones, so they don't depend on the host's libc.
_ASSET_NAMES = {
    "linux_amd64": "opa_linux_amd64_static",
    "linux_arm64": "opa_linux_arm64_static",
    "darwin_amd64": "opa_darwin_amd64",
    "darwin_arm64": "opa_darwin_arm64",
}

_EVAL_FORMATS = ["json", "values", "bindings", "pretty", "raw", "discard"]


def _shell_quote(arg:str) -> str:
    return "'" + arg.replace("'", "'\\''") + "'"


def opa_tool(name:str, version:str, hashes:list=None, url_template:str=None, visibility:list=None, labels:list=[]):
    """Downloads OPA for the host platform from GitHub Releases.

    The result can be used as the plugin's `Tool`, e.g. `//third_party/opa:opa`.

    Args:
      name: Name of the rule.
      version: The OPA version to download, e.g. "1.20.2" (without the leading 'v').
      hashes: Hashes to verify the downloaded binary with. Defaults to the host
              platform's hash for `version` in the plugin's checksum mirror
              (build_defs/versions.build_defs), if it's there and
              `url_template` isn't set.
      url_template: Downloads from here instead of GitHub Releases - with
                    `{version}` and `{asset}` (OPA's own release filename, e.g.
                    `opa_linux_amd64_static`) placeholders.
      visibility: Visibility declaration of the rule.
      labels: Labels to apply to this rule.
    """
    platform = f"{CONFIG.OS}_{CONFIG.ARCH}"
    if platform not in _ASSET_NAMES:
        fail(f"OPA doesn't publish a build for {platform} that this plugin knows about. Set the opa plugin's `Tool` config to an opa executable you provide instead.")

    if hashes == None:
        # The mirror's checksums are for OPA's own release binaries - so
        # meaningless for one fetched from somewhere else.
        known = None if url_template else OPA_VERSIONS.get(version, {}).get(platform)
        hashes = [f"sha256: {known}"] if known else []

    template = url_template or "https://github.com/open-policy-agent/opa/releases/download/v{version}/{asset}"
    return remote_file(
        name = name,
        url = template.format(version = version, asset = _ASSET_NAMES[platform]),
        out = "opa",
        hashes = hashes,
        binary = True,
        visibility = visibility,
        labels = labels,
    )


def opa_build(name:str, srcs:list, revision:str=None, out:str=None, visibility:list=None, labels:list=[]):
    """Packages Rego policies and data files into an OPA bundle (a gzipped
    tarball), via `opa build -b <root-dir> --follow-symlinks -o <out>`.

    The bundle's root directory is the one `srcs[0]` is directly inside.
    `--follow-symlinks` is always passed: Please can make a build's sources
    symlinks, which `opa build`'s bundle walker otherwise silently skips.

    Args:
      name: Name of the rule.
      srcs: Every file in the bundle - .rego policies, data.json/data.yaml
            files, and (if present) a manifest.yaml. srcs[0] must be directly
            inside the bundle's root directory.
      revision: If set, passed via `--revision` - recorded in the bundle's
                `.manifest`.
      out: Output filename. Defaults to the rule's name + '.tar.gz'.
      visibility: Visibility declaration of the rule.
      labels: Labels to apply to this rule.
    """
    args = ['"$TOOL" build -b "$(dirname "$(echo $SRCS | cut -d" " -f1)")" --follow-symlinks -o "$OUT"']
    if revision:
        args += ["--revision", _shell_quote(revision)]
    return build_rule(
        name = name,
        srcs = srcs,
        outs = [out or f"{name}.tar.gz"],
        tools = [CONFIG.OPA.TOOL],
        cmd = " ".join(args),
        building_description = "Building bundle...",
        visibility = visibility,
        labels = labels + ["opa"],
    )


def opa_eval(name:str, srcs:list, query:str, input:str=None, format:str="json", fail_undefined:bool=False,
             fail_defined:bool=False, out:str=None, visibility:list=None, labels:list=[]):
    """Evaluates a Rego `query` against `srcs` (and, if set, `input`), via `opa
    eval -d <src> [-d <src> ...] [--input <input>] --format <format> <query>`,
    with its result written to `out`.

    `fail_undefined`/`fail_defined` turn this into a build-time policy gate:
    with `fail_undefined = True`, building this rule fails outright if `query`
    evaluates to undefined/empty - e.g. "this input must satisfy policy X",
    with `input` another rule's output - the same way any other failing build
    would.

    Args:
      name: Name of the rule.
      srcs: Every .rego policy and data.json/data.yaml file `query` needs, each
            passed as its own `-d` flag (so they can span packages).
      query: The Rego query to evaluate, e.g. 'data.authz.allow'.
      input: Optional input document (.json/.yaml), passed via `--input`.
      format: Passed via `--format` - one of json, values, bindings, pretty, raw or discard.
      fail_undefined: Passed as `--fail` - fails the build on an undefined/empty result.
      fail_defined: Passed as `--fail-defined` - fails the build on a defined/non-empty result.
      out: Output filename. Defaults to the rule's name + '.json'.
      visibility: Visibility declaration of the rule.
      labels: Labels to apply to this rule.
    """
    if format not in _EVAL_FORMATS:
        fail(f"opa_eval format must be one of {_EVAL_FORMATS}, not {format}")
    args = ['"$TOOL" eval --format', format, '$(for src in $SRCS_SRCS; do echo -d "$src"; done)']
    if input:
        args += ['--input "$SRCS_INPUT"']
    if fail_undefined:
        args += ["--fail"]
    if fail_defined:
        args += ["--fail-defined"]
    args += [_shell_quote(query), '> "$OUT"']
    return build_rule(
        name = name,
        srcs = {"srcs": srcs, "input": [input] if input else []},
        outs = [out or f"{name}.json"],
        tools = [CONFIG.OPA.TOOL],
        cmd = " ".join(args),
        building_description = "Evaluating...",
        visibility = visibility,
        labels = labels + ["opa"],
    )


def opa_test(name:str, srcs:list, test_args:list=["-v"], timeout:int=0, flaky:bool|int=0, size:str=None,
             sandbox:bool=None, visibility:list=None, labels:list=[]):
    """Runs `opa test <srcs...>` against `srcs`' .rego policies and their tests
    (rules whose names start with `test_` - see
    https://www.openpolicyagent.org/docs/latest/policy-testing/), as a test.
    Passes iff every test case passes.

    Args:
      name: Name of the rule.
      srcs: Every .rego file to test - policies plus their _test.rego files.
      test_args: Extra flags passed to `opa test`, e.g. '--v0-compatible' or '--strict'.
      timeout: Maximum length of time, in seconds, to allow the test to run for.
      flaky: True to mark this as flaky and automatically rerun.
      size: Test size (enormous, large, medium or small).
      sandbox: Sandbox the test on Linux to restrict access to namespaces such as network.
      visibility: Visibility declaration of the rule.
      labels: Labels to apply to this rule.
    """
    return build_rule(
        name = name,
        data = srcs,
        outs = [f"{name}.sh"],
        # Nothing to build - the test itself runs `opa test` against `data`.
        cmd = 'echo "# Runs opa test against the data of this rule." > "$OUT"',
        test = True,
        test_cmd = " ".join(['"$TOOL" test $DATA'] + [_shell_quote(arg) for arg in test_args]),
        test_tools = [CONFIG.OPA.TOOL],
        no_test_output = True,
        test_timeout = timeout,
        flaky = flaky,
        size = size,
        test_sandbox = sandbox,
        visibility = visibility,
        labels = labels + ["opa"],
    )
